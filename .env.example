LOG_LEVEL=info
ENVIRONMENT=dev

# --- agent: model provider ---
MODEL_PROVIDER=scripted
MODEL_ID=claude-sonnet-5
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-v1:0

# --- shared identity ---
# The corporate API trusts one workload key. Generate a strong value per environment;
# a non-dev service refuses to boot while this holds its development default.
API_TELECOM_KEY=dev-mcp-server-key
API_KEYS=dev-mcp-server-key

# The downstream token (BFF -> agent -> MCP) is signed with this resource secret and
# scoped to the audience below. MCP and the agent both verify against it.
JWT_ISSUER=https://sinal.local/idp
JWT_AUDIENCE=sinal-mcp
JWT_SIGNING_SECRET=dev-only-signing-secret-change-me
DOWNSTREAM_SECRET=dev-only-signing-secret-change-me
DOWNSTREAM_AUDIENCE=sinal-mcp

# The BFF session token is signed with a SEPARATE secret and a different audience, so
# a browser session token cannot be replayed against MCP. Keep these two distinct.
SESSION_ISSUER=https://sinal.local/idp
SESSION_AUDIENCE=sinal-bff
SESSION_SECRET=dev-only-session-secret-change-me
SESSION_TTL=30m
DOWNSTREAM_TTL=5m

# Simulated identity provider. Replace with real per-user credentials in any real deploy.
DEMO_PASSWORD=demo1234

# --- service URLs ---
API_TELECOM_URL=http://localhost:8081
MCP_SERVER_URL=http://localhost:8082/mcp
AGENT_URL=http://localhost:8083
BFF_URL=http://localhost:8080
VITE_BFF_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173

# --- budgets and limits ---
TOOL_CALL_TIMEOUT_MS=8000
TOOL_CALL_MAX_RETRIES=2
UPSTREAM_CACHE_TTL_MS=3000
AGENT_MAX_TOKENS_PER_REQUEST=4096
RATE_LIMIT_MAX_REQUESTS=20
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8

# --- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=sinal
